{
  "name": "tasknotes-browser-extension",
  "version": "2.0.0",
  "private": true,
  "description": "Capture TaskNotes tasks from any web page, into mdbase or a running Obsidian vault.",
  "type": "module",
  "license": "MIT",
  "author": "Callum Alpass",
  "repository": {
    "type": "git",
    "url": "https://github.com/callumalpass/tasknotes-browser-extension.git"
  },
  "homepage": "https://github.com/callumalpass/tasknotes-browser-extension#readme",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:chrome": "node scripts/build.mjs --browser chrome",
    "build:firefox": "node scripts/build.mjs --browser firefox",
    "package": "node scripts/package.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@mdbase-dev/sdk": "0.1.34",
    "@mdbase-dev/sdk-lab": "file:vendor/mdbase-dev-sdk-lab-0.1.34.tgz",
    "@tasknotes/model": "0.3.0",
    "preact": "10.29.8",
    "tasknotes-nlp-core": "file:vendor/tasknotes-nlp-core-0.3.0-abe88d9.tgz"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/chrome": "0.3.7",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "jsdom": "27.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "globals": "16.5.0"
  }
}
